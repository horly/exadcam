# Generate a unique token and share it only with Laravel's production .env.
LISTENER_API_TOKEN=
LARAVEL_LISTENER_URL=http://127.0.0.1:8081/api/internal/listener
LISTENER_BIND=0.0.0.0
GPS_PORT=7808
GPS_API_PORT=3001
GPS_API_URL=http://127.0.0.1:3001
# JT808 BCD time is normally UTC+8; confirm the hardware's configured timezone.
GPS_TIMEZONE_MINUTES=480
VIDEO_PORT=1078
VIDEO_API_PORT=3002
VIDEO_PUBLIC_HOST=62.171.190.15
VIDEO_STORAGE=/var/lib/exadcam-media
FFMPEG_PATH=/usr/bin/ffmpeg
# Initial admission limit, to be raised only after load tests.
MAX_VIDEO_STREAMS=8

# Live listening and intercom (same internal token; no recordings).
AUDIO_PORT=1080
AUDIO_API_PORT=3003
AUDIO_API_URL=http://127.0.0.1:3003
VIDEO_API_URL=http://127.0.0.1:3002
AUDIO_ALLOWED_ORIGINS=https://exadcam.app
