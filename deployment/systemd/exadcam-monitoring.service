[Unit]
Description=EXADCAM read-only server metrics
After=local-fs.target

[Service]
Type=simple
User=exad-monitor-reader
Group=www-data
ExecStart=/usr/bin/python3 -I /usr/local/libexec/exadcam-monitoring.py
Restart=on-failure
RestartSec=5
StateDirectory=exadcam-monitoring
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
MemoryMax=64M
LimitFSIZE=2M
TasksMax=8
Nice=10

[Install]
WantedBy=multi-user.target
