[Unit]
Description=EXADCAM JT808 GPS and command listener
After=network-online.target apache2.service mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=exad-listener
Group=exad-listener
WorkingDirectory=/opt/exadcam-listener
Environment=NODE_ENV=production
EnvironmentFile=/etc/exadcam/listener.env
ExecStart=/usr/local/bin/node src/gps.js
Restart=always
RestartSec=3
TimeoutStopSec=15
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LimitNOFILE=8192
MemoryMax=512M

[Install]
WantedBy=multi-user.target
