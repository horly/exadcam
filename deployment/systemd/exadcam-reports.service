[Unit]
Description=EXADCAM report generation worker
After=network.target mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/exadcam
ExecStart=/usr/bin/php -d memory_limit=384M artisan queue:work database --queue=reports --sleep=1 --tries=1 --timeout=75 --max-time=3600
Restart=always
RestartSec=3
Nice=10
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/exadcam/storage /var/www/exadcam/bootstrap/cache

[Install]
WantedBy=multi-user.target
